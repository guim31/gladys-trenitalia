      "key": "status",
      "label": {
        "en": "Status",
        "fr": "État",
        "de": "Status",
        "es": "Estado"
      },
      "description": {
        "en": "Lists the watched stations and the last read of Viaggiatreno.",
        "fr": "Liste les gares suivies et la dernière lecture de Viaggiatreno.",
        "de": "Listet die verfolgten Bahnhöfe und die letzte Abfrage von Viaggiatreno auf.",
