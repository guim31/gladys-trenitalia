{
  "manifest_version": 1,
  "type": "device",
  "name": "Trenitalia",
  "description": {
    "en": "Next trains of your Italian stations in real time (Viaggiatreno): delays, platforms, cancellations.",
    "fr": "Prochains trains de vos gares italiennes en temps réel : retards, voies et suppressions.",
    "de": "Nächste Züge deiner italienischen Bahnhöfe in Echtzeit: Verspätungen, Gleise, Ausfälle.",
    "es": "Próximos trenes de sus estaciones italianas en tiempo real: retrasos, vías, cancelaciones."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-trenitalia:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-trenitalia/main/cover.png",
  "categories": ["services"],
  "countries": ["IT"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Comment ça marche",
        "de": "So funktioniert es",
        "es": "Cómo funciona"
      },
      "description": {
        "en": "Watch stations with the actions below, then create their devices in the Discover tab. Everything comes from Viaggiatreno, the free real-time board of RFI and Trenitalia: no account, no key.",
        "fr": "Suivez des gares avec les actions ci-dessous, puis créez leurs appareils dans l'onglet Découverte. Tout vient de Viaggiatreno, le tableau temps réel gratuit de RFI et Trenitalia : ni compte, ni clé.",
        "de": "Verfolge Bahnhöfe mit den Aktionen unten und lege dann ihre Geräte im Tab „Entdecken“ an. Alles stammt aus Viaggiatreno, der kostenlosen Echtzeit-Anzeige von RFI und Trenitalia: kein Konto, kein Schlüssel.",
        "es": "Siga estaciones con las acciones de abajo y luego cree sus dispositivos en la pestaña Descubrir. Todo procede de Viaggiatreno, el panel gratuito en tiempo real de RFI y Trenitalia: sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-trenitalia/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the feature names and of the texts sent to your scenes. Feature names are set when a device is created.",
        "fr": "Langue des noms de fonctionnalités et des textes envoyés à vos scènes. Les noms sont fixés à la création d'un appareil.",
        "de": "Sprache der Funktionsnamen und der Texte für deine Szenen. Die Namen werden beim Anlegen eines Geräts festgelegt.",
        "es": "Idioma de los nombres de las funciones y de los textos enviados a sus escenas. Los nombres se fijan al crear un dispositivo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Viaggiatreno is read: one request per watched station.",
        "fr": "Fréquence de lecture de Viaggiatreno : une requête par gare suivie.",
        "de": "Wie oft Viaggiatreno gelesen wird: eine Anfrage pro verfolgtem Bahnhof.",
        "es": "Frecuencia de lectura de Viaggiatreno: una petición por estación seguida."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search_stations",
      "label": {
        "en": "Find a station",
        "fr": "Chercher une gare",
        "de": "Bahnhof suchen",
        "es": "Buscar una estación"
      },
      "description": {
        "en": "Lists the stations whose name starts with a text, with their code.",
        "fr": "Liste les gares dont le nom commence par un texte, avec leur code.",
        "de": "Listet die Bahnhöfe auf, deren Name mit einem Text beginnt, mit ihrem Code.",
        "es": "Muestra las estaciones cuyo nombre empieza por un texto, con su código."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "required": true,
          "label": {
            "en": "Beginning of the station name",
            "fr": "Début du nom de la gare",
            "de": "Anfang des Bahnhofsnamens",
            "es": "Principio del nombre de la estación"
          },
          "placeholder": {
            "en": "e.g. Milano",
            "fr": "ex. Milano",
            "de": "z. B. Milano",
            "es": "p. ej. Milano"
          }
        }
      ]
    },
    {
      "key": "add_station",
      "label": {
        "en": "Watch a station",
        "fr": "Suivre une gare",
        "de": "Bahnhof verfolgen",
        "es": "Seguir una estación"
      },
      "description": {
        "en": "Watches the departures of a station, with an optional category of train and destination.",
        "fr": "Suit les départs d'une gare, avec une catégorie de train et une destination facultatives.",
        "de": "Verfolgt die Abfahrten eines Bahnhofs, optional nach Zugkategorie und Ziel.",
        "es": "Sigue las salidas de una estación, con una categoría de tren y un destino opcionales."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "station",
          "type": "string",
          "required": true,
          "label": {
            "en": "Station name or code",
            "fr": "Nom ou code de la gare",
            "de": "Name oder Code des Bahnhofs",
            "es": "Nombre o código de la estación"
          },
          "placeholder": {
            "en": "e.g. Milano Centrale or S01700",
            "fr": "ex. Milano Centrale ou S01700",
            "de": "z. B. Milano Centrale oder S01700",
            "es": "p. ej. Milano Centrale o S01700"
          }
        },
        {
          "key": "category",
          "type": "select",
          "required": false,
          "label": {
            "en": "Category of train (empty: all)",
            "fr": "Catégorie de train (vide : toutes)",
            "de": "Zugkategorie (leer: alle)",
            "es": "Categoría de tren (vacío: todas)"
          },
          "options": [
            {
              "value": "regional",
              "label": {
                "en": "Regional only (REG, RV)",
                "fr": "Régionaux seulement (REG, RV)",
                "de": "Nur Regionalzüge (REG, RV)",
                "es": "Solo regionales (REG, RV)"
              }
            },
            {
              "value": "high_speed",
              "label": {
                "en": "Frecce only (FR, FA, FB)",
                "fr": "Frecce seulement (FR, FA, FB)",
                "de": "Nur Frecce (FR, FA, FB)",
                "es": "Solo Frecce (FR, FA, FB)"
              }
            },
            {
              "value": "intercity",
              "label": {
                "en": "Intercity only (IC, ICN, EC, EN)",
                "fr": "Intercity seulement (IC, ICN, EC, EN)",
                "de": "Nur Intercity (IC, ICN, EC, EN)",
                "es": "Solo Intercity (IC, ICN, EC, EN)"
              }
            }
          ]
        },
        {
          "key": "destination",
          "type": "string",
          "required": false,
          "label": {
            "en": "Destination (empty: all)",
            "fr": "Destination (vide : toutes)",
            "de": "Ziel (leer: alle)",
            "es": "Destino (vacío: todos)"
          },
          "description": {
            "en": "Part of the destination of the trains: Napoli, Torino…",
            "fr": "Partie de la destination des trains : Napoli, Torino…",
            "de": "Teil des Zugziels: Napoli, Torino…",
            "es": "Parte del destino de los trenes: Napoli, Torino…"
          },
          "placeholder": {
            "en": "e.g. Napoli",
            "fr": "ex. Napoli",
            "de": "z. B. Napoli",
            "es": "p. ej. Napoli"
          }
        }
      ]
    },
    {
      "key": "remove_station",
      "label": {
        "en": "Stop watching a station",
        "fr": "Ne plus suivre une gare",
        "de": "Bahnhof nicht mehr verfolgen",
        "es": "Dejar de seguir una estación"
      },
      "description": {
        "en": "Removes a watched station. Its device stays in Gladys until you delete it.",
        "fr": "Retire une gare suivie. Son appareil reste dans Gladys jusqu'à ce que vous le supprimiez.",
        "de": "Entfernt einen verfolgten Bahnhof. Sein Gerät bleibt in Gladys, bis du es löschst.",
        "es": "Elimina una estación seguida. Su dispositivo permanece en Gladys hasta que lo elimine."
      },
      "fields": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name shown in the status",
            "fr": "Nom affiché dans l'état",
            "de": "Name aus dem Status",
            "es": "Nombre mostrado en el estado"
          },
          "placeholder": {
            "en": "e.g. Roma Termini (Frecce)",
            "fr": "ex. Roma Termini (Frecce)",
            "de": "z. B. Roma Termini (Frecce)",
            "es": "p. ej. Roma Termini (Frecce)"
          }
        }
      ]
    },
